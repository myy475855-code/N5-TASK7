{
  "info": {
    "name": "Internship RBAC Authorization",
    "_postman_id": "internship-rbac-task6",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "studentToken",
      "value": ""
    },
    {
      "key": "companyToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login Student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"student@example.com\",\"password\":\"Password123!\"}"
        }
      }
    },
    {
      "name": "Login Company",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"company@example.com\",\"password\":\"Password123!\"}"
        }
      }
    },
    {
      "name": "Login Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"admin@example.com\",\"password\":\"Password123!\"}"
        }
      }
    },
    {
      "name": "Company Bypass Attempt \u2014 Expected 403",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{companyToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/internships/2",
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Unauthorized edit\"}"
        }
      }
    },
    {
      "name": "Student Other Application \u2014 Expected 403",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{studentToken}}"
          }
        ],
        "url": "{{baseUrl}}/applications/2"
      }
    },
    {
      "name": "Admin Moderate Internship",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/admin/internships/2/status",
        "body": {
          "mode": "raw",
          "raw": "{\"is_active\":false}"
        }
      }
    }
  ]
}